{
  "name": "COMMAX Wallpad by Zaswedx",
  "version": "1.2.0",
  "slug": "cwbs_cloud",
  "url": "https://github.com/kimtc99/HAaddons",
  "description": "mqtt 통신을 활용한 코맥스 월패드 컨트롤러",
  "arch": ["armhf", "armv7", "aarch64", "amd64", "i386"],
  "map": [
    "share:rw"
  ],
  "startup": "application",
  "boot": "auto",
  "options": {
    "DEBUG": false,
    "mqtt_log": true,
    "elfin_log": false,
    "mqtt_server": "192.168.x.x",
    "mqtt_id": "id",
    "mqtt_password": "password",
    "mqtt_TOPIC": "cwbs_cloud",
    "mqtt_client_id": "cwbs_cloud_addon",
    "discovery_prefix": "cwbs_cloud",
    "found_device_file": "cwbs_cloud_found_device.json",
    "elfin_server": "192.168.x.x",
    "elfin_id": "admin",
    "elfin_password": "elfin_password",
    "cloud_light_enabled": false,
    "cloud_verbose_log": true,
    "cloud_username": "",
    "cloud_password": "",
    "cloud_client_id": "APP-AND-com.commax.ipiot",
    "cloud_client_secret": "",
    "cloud_dvc_os": "AND",
    "cloud_app_version": "0.0.0.1",
    "cloud_auth_url": "https://biz.ruvie.co.kr:4000/oauth/authorize",
    "cloud_base_url": "https://api.ruvie.co.kr:4100",
    "cloud_command_endpoint": "/v1/command/",
    "cloud_gateways_endpoint": "/v1/gateways",
    "cloud_gateway_detail_endpoint": "/v1/gateways/{gateway_no}",
    "cloud_timeout": 10,
    "cloud_refresh_margin": 60
  },
  "schema": {
    "DEBUG": "bool",
    "mqtt_log": "bool",
    "elfin_log": "bool",
    "mqtt_server": "str",
    "mqtt_id": "str",
    "mqtt_password": "str",
    "mqtt_TOPIC": "str",
    "mqtt_client_id": "str",
    "discovery_prefix": "str",
    "found_device_file": "str",
    "elfin_server": "str",
    "elfin_id": "str",
    "elfin_password": "str",
    "cloud_light_enabled": "bool",
    "cloud_verbose_log": "bool",
    "cloud_username": "str",
    "cloud_password": "password",
    "cloud_client_id": "str",
    "cloud_client_secret": "password",
    "cloud_dvc_os": "str",
    "cloud_app_version": "str",
    "cloud_auth_url": "str",
    "cloud_base_url": "str",
    "cloud_command_endpoint": "str",
    "cloud_gateways_endpoint": "str",
    "cloud_gateway_detail_endpoint": "str",
    "cloud_timeout": "int",
    "cloud_refresh_margin": "int"
  }
}
